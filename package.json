{
  "name": "abyss-theme-for-vscode",
  "displayName": "Abyss Theme for VS Code",
  "description": "A pure-black VS Code theme with a consistent workbench and familiar Dark+ syntax highlighting.",
  "version": "1.1.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jadchene/abyss-theme-for-vscode.git"
  },
  "homepage": "https://github.com/jadchene/abyss-theme-for-vscode#readme",
  "bugs": {
    "url": "https://github.com/jadchene/abyss-theme-for-vscode/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "black",
    "dark",
    "monochrome"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.controlsStyle": "custom"
    },
    "themes": [
      {
        "label": "Abyss Theme for VS Code",
